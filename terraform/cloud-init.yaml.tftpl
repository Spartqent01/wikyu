#cloud-config

users:
  - name: ops
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_public_key}

disable_root: true
ssh_pwauth: false

package_update: true
package_upgrade: true
packages: [ca-certificates, curl, ufw]

write_files:
  - path: /opt/deploy/docker-compose.yml
    permissions: "0644"
    content: ${jsonencode(compose)}
  - path: /opt/deploy/.env
    permissions: "0644"
    content: |
      WIKI_DOMAIN=${wiki_domain}
      LETSENCRYPT_EMAIL=${letsencrypt_email}
  - path: /opt/deploy/secrets/db_password.txt
    permissions: "0644"
    content: ${jsonencode(db_password)}
  - path: /root/.docker/config.json
    permissions: "0600"
    content: ${jsonencode(docker_config)}

runcmd:
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker ops
  - ufw allow 22/tcp
  - ufw allow 80/tcp
  - ufw allow 443/tcp
  - ufw --force enable
  - chmod 700 /opt/deploy/secrets
  - docker compose -f /opt/deploy/docker-compose.yml up -d

final_message: "cloud-init terminé en $UPTIME secondes"
